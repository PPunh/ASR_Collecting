# Copy this file to .env and adjust the values for your PythonAnywhere site.
# The .env file must sit next to settings.py (inside django-project/).

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated list of hosts
ALLOWED_HOSTS=yourusername.pythonanywhere.com,127.0.0.1,localhost

# Database (SQLite is the default for PythonAnywhere free tier).
# The commented values below show what a MySQL setup would look like.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=yourusername$mydb
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306
# DB_USER=yourusername
# DB_PASSWORD=your-db-password